<section class="panel stages-panel" aria-labelledby="tituloEtapas">
    <h2 id="tituloEtapas">Etapas del proceso</h2>
    <ol class="process-steps">
        @foreach (var etapa in new[] { ("file", "Recepción y verificación"), ("search-file", "Evaluación técnica y académica"), ("users", "Aprobación y resolución"), ("check", "Notificación y registro académico") })
        {
            <li><span class="step-icon"><partial name="_Icon" model="etapa.Item1" /></span><span>@etapa.Item2</span></li>
        }
    </ol>
    <p class="process-caption">Guía del proceso. El estado real se muestra en cada expediente.</p>
</section>

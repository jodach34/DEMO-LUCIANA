@model ErrorViewModel
@{ ViewData["Title"] = "Error al procesar"; }
<section class="panel reading-panel"><p class="eyebrow">NO SE COMPLETÓ LA OPERACIÓN</p><h1>Ocurrió un error inesperado</h1><p>Vuelve al panel y consulta el estado de la solicitud antes de repetir la operación.</p>
@if (Model.ShowRequestId) { <p class="small text-secondary">Referencia para revisar los registros: <code>@Model.RequestId</code></p> }
<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al panel</a></section>

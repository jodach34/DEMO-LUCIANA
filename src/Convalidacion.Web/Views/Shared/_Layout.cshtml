@{ var mensaje = TempData["Mensaje"] as string; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Demo académica del proceso de convalidación de asignaturas FIA–EPICS." />
    <title>@ViewData["Title"] · Convalidaciones FIA–EPICS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#contenido">Saltar al contenido</a>
    <partial name="_MenuLateral" />
    <div class="workspace">
        <partial name="_BarraSuperior" model="@(mensaje ?? string.Empty)" />
        <main class="page-content" id="contenido" tabindex="-1">
            @if (mensaje is not null)
            { <partial name="_Aviso" model="mensaje" /> }
            @RenderBody()
        </main>
        <footer class="page-footer">
            <span>USMP · Facultad de Ingeniería y Arquitectura · EPICS</span>
            <span>Demo académica · Datos ficticios · Sin validez administrativa</span>
        </footer>
    </div>
    <div class="modal fade" id="reiniciarDemo" tabindex="-1" aria-labelledby="tituloReinicio" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-controller="Complementos" asp-action="Reiniciar" method="post">
            <div class="modal-header"><h2 class="modal-title fs-5" id="tituloReinicio">¿Reiniciar demostración?</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body"><p>Se reemplazarán los expedientes y avisos de tu sesión actual por los seis ejemplos iniciales. Se perderán tus cambios de demostración.</p><p>El catálogo y los datos de otros visitantes se conservan.</p><div class="form-check"><input class="form-check-input" id="confirmarReinicio" name="confirmar" value="true" type="checkbox" required /><label class="form-check-label" for="confirmarReinicio">Confirmo que quiero reiniciar mi sesión de demostración.</label></div></div>
            <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit">Reiniciar demostración</button></div>
        </form></div></div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@inject Convalidacion.Web.Services.PerfilDemoService Perfiles
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString(); var action = ViewContext.RouteData.Values["action"]?.ToString();
    var inicio = controller == "Home" && action == "Index"; var nueva = controller == "Solicitudes" && action == "Crear";
    var bandeja = controller == "Solicitudes" && action is "Index" or "Detalle"; var acerca = controller == "Home" && action == "Privacy";
    var pendientes = Context.Request.Query["pendientes"] == "true"; var dictamen = action == "Dictamen" || Context.Request.Query["conDictamen"] == "true";
    var resolucion = action == "Resolucion" || Context.Request.Query["conResolucion"] == "true";
}
<aside class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="menuLateral" aria-labelledby="nombrePlataforma">
    <div class="sidebar-brand"><a class="logo-frame" asp-controller="Home" asp-action="Index" aria-label="USMP · Ir al inicio"><img src="~/images/usmp-logo.jpg" alt="USMP · Universidad de San Martín de Porres" width="2412" height="933" /></a><div class="platform-name" id="nombrePlataforma">Plataforma de<br /><strong>Convalidaciones</strong></div><button type="button" class="sidebar-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#menuLateral" aria-label="Cerrar menú">×</button></div>
    <nav class="sidebar-nav" aria-label="Navegación principal">
        <a class="sidebar-link @(inicio ? "active" : "")" aria-current="@(inicio ? "page" : null)" asp-controller="Home" asp-action="Index"><partial name="_Icon" model='@("home")' /><span>Inicio</span></a>
        <div class="sidebar-group"><partial name="_Icon" model='@("layers")' /><span>Convalidación</span><partial name="_Icon" model='@("chevron-down")' /></div>
        <div class="sidebar-subnav">
            @if(Perfiles.Actual == PerfilDemo.Estudiante){ <a class="sidebar-link @(nueva ? "active" : "")" aria-current="@(nueva ? "page" : null)" asp-controller="Solicitudes" asp-action="Crear"><partial name="_Icon" model='@("file-plus")' /><span>Nueva solicitud</span></a> }
            <a class="sidebar-link @(bandeja && !pendientes && !dictamen && !resolucion ? "active" : "")" aria-current="@(bandeja && !pendientes && !dictamen && !resolucion ? "page" : null)" asp-controller="Solicitudes" asp-action="Index"><partial name="_Icon" model='@("file")' /><span>@(Perfiles.Actual == PerfilDemo.Estudiante ? "Mis solicitudes" : "Expedientes")</span></a>
            <a class="sidebar-link @(bandeja && pendientes ? "active" : "")" aria-current="@(bandeja && pendientes ? "page" : null)" asp-controller="Solicitudes" asp-action="Index" asp-route-pendientes="true"><partial name="_Icon" model='@("clipboard")' /><span>@(Perfiles.Actual == PerfilDemo.Estudiante ? "Por subsanar" : "Mi bandeja de atención")</span></a>
            <a class="sidebar-link @(dictamen ? "active" : "")" aria-current="@(dictamen ? "page" : null)" asp-controller="Solicitudes" asp-action="Index" asp-route-conDictamen="true"><partial name="_Icon" model='@("book")' /><span>Dictámenes</span></a>
            <a class="sidebar-link @(resolucion ? "active" : "")" aria-current="@(resolucion ? "page" : null)" asp-controller="Solicitudes" asp-action="Index" asp-route-conResolucion="true"><partial name="_Icon" model='@("file")' /><span>Resoluciones</span></a>
        </div>
        <div class="sidebar-divider"></div>
        @foreach(var enlace in new[]{("Calculadora", "Calculadora orientativa", "clipboard"), ("Equivalencias", "Equivalencias por plan", "book"), ("Indicadores", "Indicadores KPI", "chart"), ("Proceso", "AS-IS / TO-BE", "layers"), ("Ayuda", "Preguntas frecuentes", "help")})
        {<a class="sidebar-link @(controller == "Complementos" && action == enlace.Item1 ? "active" : "")" aria-current="@(controller == "Complementos" && action == enlace.Item1 ? "page" : null)" asp-controller="Complementos" asp-action="@enlace.Item1"><partial name="_Icon" model="@enlace.Item3" /><span>@enlace.Item2</span></a>}
        <a class="sidebar-link @(controller == "Notificaciones" ? "active" : "")" asp-controller="Notificaciones" asp-action="Index"><partial name="_Icon" model='@("bell")' /><span>Notificaciones</span></a>
        <a class="sidebar-link @(acerca ? "active" : "")" aria-current="@(acerca ? "page" : null)" asp-controller="Home" asp-action="Privacy"><partial name="_Icon" model='@("help")' /><span>Acerca de la demo</span></a>
        <button type="button" class="sidebar-link sidebar-reset" data-bs-toggle="modal" data-bs-target="#reiniciarDemo"><partial name="_Icon" model='@("layers")' /><span>Reiniciar demostración</span></button>
    </nav>
    <div class="sidebar-bottom"><span class="demo-label">DEMO ACADÉMICA</span><span>Gestión de Procesos · FIA–EPICS</span></div>
</aside>

@model CrearSolicitudViewModel
@inject Convalidacion.Web.Services.PerfilDemoService Perfiles
@{ ViewData["Title"] = "Nueva solicitud"; var catalogo = (IReadOnlyList<Asignatura>)ViewBag.Asignaturas; }
<a asp-action="Index" class="back-link">← Volver a solicitudes</a>
<p class="eyebrow mt-4">ETAPA 1 / RECEPCIÓN Y VERIFICACIÓN DE EXPEDIENTE</p><h1>Nueva solicitud</h1>
<p class="text-secondary mb-4">Un expediente puede incluir hasta 20 asignaturas. Utiliza exclusivamente datos y documentos ficticios.</p>
@if (Perfiles.Actual != PerfilDemo.Estudiante)
{ <div class="alert alert-warning">Selecciona Estudiante en la esquina superior derecha para registrar una solicitud.</div> }
<div class="row g-4"><div class="col-xl-9"><form asp-action="Crear" method="post" class="panel" data-submit-once id="formNuevaSolicitud">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <h2 class="mb-4">Información del expediente</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-6"><label asp-for="Estudiante" class="form-label"></label><input asp-for="Estudiante" class="form-control" /><span asp-validation-for="Estudiante" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="InstitucionOrigen" class="form-label"></label><input asp-for="InstitucionOrigen" class="form-control" /><span asp-validation-for="InstitucionOrigen" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="CertificadoDocumento" class="form-label"></label><select asp-for="CertificadoDocumento" class="form-select"><option value="">Selecciona un documento ficticio</option>@foreach(var d in DocumentosDemo.Certificados) { <option value="@d.Key">@d.Value (@d.Key)</option> }</select><span asp-validation-for="CertificadoDocumento" class="text-danger"></span></div>
    </div>
    <div class="section-heading"><h2>Asignaturas solicitadas</h2><button class="btn btn-outline-primary btn-sm" type="button" id="agregarCurso">+ Agregar asignatura</button></div>
    <p class="small text-secondary">Catálogo de demostración: no corresponde a un plan de estudios oficial. El Director registra la coincidencia y su decisión durante la evaluación.</p>
    <div id="cursosSolicitud">
        @for (var i = 0; i < Model.Cursos.Count; i++)
        {
            <fieldset class="course-editor mb-3" data-course>
                <legend>Asignatura <span data-course-number>@(i + 1)</span></legend>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Cursos[i].AsignaturaOrigen" class="form-label"></label><input asp-for="Cursos[i].AsignaturaOrigen" class="form-control" /><span asp-validation-for="Cursos[i].AsignaturaOrigen" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Cursos[i].AsignaturaId" class="form-label"></label><select asp-for="Cursos[i].AsignaturaId" class="form-select"><option value="0">Selecciona un curso ficticio</option>@foreach(var a in catalogo) { <option value="@a.Id">@a.Codigo · @a.Nombre (@a.Creditos créditos)</option> }</select><span asp-validation-for="Cursos[i].AsignaturaId" class="text-danger"></span></div>
                    <div class="col-md-3"><label asp-for="Cursos[i].CreditosOrigen" class="form-label"></label><input asp-for="Cursos[i].CreditosOrigen" class="form-control" /><span asp-validation-for="Cursos[i].CreditosOrigen" class="text-danger"></span></div>
                    <div class="col-md-3"><label asp-for="Cursos[i].Nota" class="form-label"></label><input asp-for="Cursos[i].Nota" class="form-control" /><span asp-validation-for="Cursos[i].Nota" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Cursos[i].SilaboDocumento" class="form-label"></label><select asp-for="Cursos[i].SilaboDocumento" class="form-select"><option value="">Selecciona un sílabo ficticio</option>@foreach(var d in DocumentosDemo.Silabos) { <option value="@d.Key">@d.Value</option> }</select><span asp-validation-for="Cursos[i].SilaboDocumento" class="text-danger"></span></div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mt-3" data-remove-course>Quitar asignatura</button>
            </fieldset>
        }
    </div>
    <p id="avisoCursos" class="small text-secondary" role="status"></p>
    <button class="btn btn-primary" type="submit" disabled="@(Perfiles.Actual != PerfilDemo.Estudiante)">Presentar solicitud</button>
    <a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancelar</a>
</form></div><aside class="col-xl-3"><div class="info-card"><p class="eyebrow">ANTES DE ENVIAR</p><h2>Un expediente completo</h2><p>Selecciona un certificado y un sílabo simulado por asignatura. Admisión verificará el expediente y podrá solicitar correcciones.</p><hr /><p class="small">No se cargan archivos reales. Los criterios académicos son referenciales: 80% de coincidencia o excepción justificada desde 70% por afinidad directa y créditos equivalentes. La decisión es individual y manual.</p></div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

@model DetalleViewModel
@using Convalidacion.Web.Services
@{ ViewData["Title"] = Model.Solicitud.Codigo; var s = Model.Solicitud; var acciones = SolicitudService.Acciones(s.Estado, Model.Perfil); }
<a asp-action="Index" class="back-link">← Volver a solicitudes</a>
<div class="section-heading mt-4 mb-4"><div><p class="eyebrow">EXPEDIENTE ACADÉMICO SIMULADO</p><h1>@s.Codigo</h1><p class="text-secondary mb-0">Registrado el @s.CreadaUtc.ToString("dd/MM/yyyy HH:mm") UTC · Perfil: @Model.Perfil.Texto()</p></div><span class="status status-@s.Estado">@s.Estado.Texto()</span></div>
<div class="row g-4"><div class="col-lg-8">
    <section class="panel mb-4"><h2>Información de la solicitud</h2><dl class="row detail-list mt-4">
        <dt class="col-sm-4">Estudiante ficticio</dt><dd class="col-sm-8">@s.Estudiante</dd>
        <dt class="col-sm-4">Institución de origen</dt><dd class="col-sm-8">@s.InstitucionOrigen</dd>
        <dt class="col-sm-4">Asignatura de origen</dt><dd class="col-sm-8">@s.AsignaturaOrigen</dd>
        <dt class="col-sm-4">Asignatura de destino</dt><dd class="col-sm-8">@s.Asignatura.Codigo · @s.Asignatura.Nombre</dd>
        <dt class="col-sm-4">Documentos</dt><dd class="col-sm-8">Certificado y sílabo confirmados (simulados)</dd>
    </dl><div class="criteria-grid">
        <div><span>Nota obtenida</span><strong>@s.Nota / 20</strong><small>Mínimo demo: 11</small></div>
        <div><span>Créditos de origen</span><strong>@s.CreditosOrigen</strong><small>Destino: @s.Asignatura.Creditos</small></div>
        <div><span>Coincidencia</span><strong>@s.Coincidencia%</strong><small>Mínimo demo: 80%</small></div>
    </div><p class="small mt-3 mb-0 text-secondary">@(SolicitudService.CumpleCriterios(s) ? "Cumple los criterios orientativos de la demo. La decisión requiere evaluación de la comisión." : "No cumple los criterios orientativos de la demo. La aprobación está deshabilitada por las reglas del proceso.")</p></section>
    <section class="panel"><h2>Historial del expediente</h2><p class="text-secondary small">Cada cambio conserva el perfil simulado, la fecha y el sustento. Horas en UTC.</p><ol class="timeline">
        @foreach (var evento in s.Historial.OrderBy(h => h.FechaUtc).ThenBy(h => h.Id))
        { <li><div class="d-flex justify-content-between flex-wrap gap-2"><strong>@evento.Estado.Texto()</strong><time class="small text-secondary">@evento.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC</time></div><span class="small text-secondary">@evento.Perfil.Texto()</span><p>@evento.Comentario</p></li> }
    </ol></section>
</div><aside class="col-lg-4"><section class="panel action-panel"><p class="eyebrow">SIGUIENTE PASO</p><h2>Atender solicitud</h2>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (acciones.Length > 0)
    {
        <p class="small text-secondary">Actúas como @Model.Perfil.Texto(). Todo cambio requiere sustento.</p>
        <form asp-action="Ejecutar" method="post" data-submit-once>
            <input type="hidden" name="Id" value="@Model.Accion.Id" /><input type="hidden" name="Revision" value="@Model.Accion.Revision" />
            <label for="Accion" class="form-label">Acción</label><select id="Accion" name="Accion" class="form-select mb-3">
                @foreach (var accion in acciones) { <option value="@accion" selected="@(Model.Accion.Accion == accion)" disabled="@(accion == AccionSolicitud.Aprobar && !SolicitudService.CumpleCriterios(s))">@accion.Texto()</option> }
            </select>
            <label for="Comentario" class="form-label">Sustento / comentario</label><textarea id="Comentario" name="Comentario" class="form-control mb-3" rows="5" required minlength="5" maxlength="1000" placeholder="Describe la evaluación o subsanación simulada…">@Model.Accion.Comentario</textarea>
            <button class="btn btn-primary w-100" type="submit">Registrar cambio</button>
        </form>
    }
    else if (s.Estado is EstadoSolicitud.Aprobada or EstadoSolicitud.Rechazada)
    { <p>Evaluación finalizada. La decisión y su sustento están disponibles en el historial.</p><p class="small text-secondary">Esta decisión es ficticia y carece de validez administrativa.</p> }
    else
    { <p>Cambia el perfil simulado en el menú superior para continuar.</p><p class="small text-secondary">Recibida → Secretaría<br />En revisión → Comisión académica<br />Observada → Estudiante (subsanación)</p> }
    <hr /><a asp-action="Detalle" asp-route-id="@s.Id">Actualizar expediente →</a>
</section><p class="small text-secondary mt-3">Los perfiles son perspectivas de tu sesión de demo. Puedes cambiarlos para recorrer el proceso; los expedientes y comentarios de otros navegadores no se muestran.</p></aside></div>
